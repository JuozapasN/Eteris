<Window x:Class="RadioPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Icon="app.ico"
        Width="320"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Window}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Ui}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <StackPanel Margin="16,16,16,14">

        <!-- Up to six stations show at once; more than that scroll. -->
        <ScrollViewer x:Name="StationScroll" MaxHeight="392" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl ItemsSource="{Binding Stations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource StationButton}" Click="Station_Click"
                                AutomationProperties.Name="{Binding Name}"
                                AutomationProperties.HelpText="{Binding Status}"
                                AutomationProperties.ItemStatus="{Binding Subtitle}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Move up" Click="MoveUp_Click" />
                                    <MenuItem Header="Move down" Click="MoveDown_Click" />
                                    <Separator />
                                    <MenuItem Header="Remove" Click="Remove_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Margin="-6,-4,-6,6">
            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Left" Click="Add_Click"
                    ToolTip="Find a station or enter a stream address" AutomationProperties.Name="Add station">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource Icons}" FontSize="11" Text="&#xE710;"
                               VerticalAlignment="Center" Margin="0,1,6,0" />
                    <TextBlock FontSize="12" Text="Add station" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="Mini_Click"
                    ToolTip="Mini player: a small strip that stays on top" AutomationProperties.Name="Mini player">
                <TextBlock FontFamily="{StaticResource Icons}" FontSize="14" Text="&#xE73F;" />
            </Button>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource PlayButton}" Width="46" Height="46" Click="PlayPause_Click"
                    ToolTip="Play / pause (Space)" AutomationProperties.Name="{Binding PlayLabel}">
                <TextBlock FontFamily="{StaticResource Icons}" FontSize="18" Text="{Binding PlayGlyph}" />
            </Button>

            <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="10,0,2,0" Click="Mute_Click"
                    ToolTip="Mute (M)" AutomationProperties.Name="Mute">
                <TextBlock FontFamily="{StaticResource Icons}" FontSize="16" Text="{Binding VolumeGlyph}" />
            </Button>

            <Slider Grid.Column="2" Style="{StaticResource VolumeSlider}" VerticalAlignment="Center"
                    Value="{Binding Volume, Mode=TwoWay}" AutomationProperties.Name="Volume" />

            <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"
                       Foreground="{StaticResource Muted}" Text="{Binding VolumeText}" />
        </Grid>
    </StackPanel>
</Window>
