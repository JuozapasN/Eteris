<Window x:Class="RadioPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Radio"
        Icon="app.ico"
        Width="320"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#15171C"
        Foreground="#F2F3F5"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#1E2128" />
        <SolidColorBrush x:Key="CardHover" Color="#272B34" />
        <SolidColorBrush x:Key="Muted" Color="#8B93A1" />
        <SolidColorBrush x:Key="Accent" Color="#FF6A3D" />
        <SolidColorBrush x:Key="AccentHover" Color="#FF8259" />
        <SolidColorBrush x:Key="TrackRest" Color="#343945" />
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- One station row -->
        <Style x:Key="StationButton" TargetType="Button">
            <!-- Buttons default to black text and don't inherit the window's colour, so set it here. -->
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="card" Background="{StaticResource Card}" BorderBrush="Transparent"
                                BorderThickness="1.5" CornerRadius="10" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Note}" FontSize="12" Margin="0,1,0,0"
                                               Foreground="{StaticResource Muted}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="dot" Width="7" Height="7" Margin="0,1,6,0"
                                             Fill="{StaticResource Accent}" Visibility="Collapsed" />
                                    <TextBlock x:Name="status" Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="Background" Value="{StaticResource CardHover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="status" Property="Foreground" Value="{StaticResource Accent}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round play/pause button -->
        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="bg" Fill="{StaticResource Accent}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="{StaticResource AccentHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat icon button (mute) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#F2F3F5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Volume slider -->
        <Style x:Key="TrackPart" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VolumeThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent" Width="16" Height="24">
                            <Ellipse Width="14" Height="14" Fill="#F2F3F5" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VolumeSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" Height="24">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource TrackPart}"
                                              Background="{StaticResource Accent}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource TrackPart}"
                                              Background="{StaticResource TrackRest}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource VolumeThumb}" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16,16,16,14">
        <ItemsControl x:Name="StationList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource StationButton}" Click="Station_Click"
                            AutomationProperties.Name="{Binding Name}"
                            AutomationProperties.HelpText="{Binding Status}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>

            <Button x:Name="PlayPause" Style="{StaticResource PlayButton}" Width="46" Height="46"
                    Click="PlayPause_Click" ToolTip="Play / pause (Space)" AutomationProperties.Name="Play">
                <TextBlock x:Name="PlayGlyph" FontFamily="{StaticResource Icons}" FontSize="18"
                           Foreground="#15171C" Text="&#xE768;" />
            </Button>

            <Button x:Name="Mute" Grid.Column="1" Style="{StaticResource IconButton}" Margin="10,0,2,0"
                    Click="Mute_Click" ToolTip="Mute (M)" AutomationProperties.Name="Mute">
                <TextBlock x:Name="VolumeGlyph" FontFamily="{StaticResource Icons}" FontSize="16" Text="&#xE767;" />
            </Button>

            <Slider x:Name="Volume" Grid.Column="2" Style="{StaticResource VolumeSlider}" VerticalAlignment="Center"
                    ValueChanged="Volume_ValueChanged" AutomationProperties.Name="Volume" />

            <TextBlock x:Name="VolumeText" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                       FontSize="12" Foreground="{StaticResource Muted}" Text="50" />
        </Grid>
    </StackPanel>
</Window>
